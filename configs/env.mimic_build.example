# Example environment for building MIMIC prebuilt pickles (Layer 1).
# Copy to configs/env.mimic_build and edit paths.
#
# Requires PhysioNet credentialed access:
#   https://physionet.org/content/mimic-iv-ecg/1.0/
#   https://physionet.org/content/mimic-iv-ecg-ext-icd-labels/1.0.1/

export MOF_MEASUREMENTS_CSV=/path/to/machine_measurements.csv
export MOF_LABELS_CSV=/path/to/records_w_diag_icd10.csv
export MOF_WFDB_ROOT=/path/to/mimic_iv_ecg/files
export MOF_PREBUILT_ROOT=/path/to/prebuilt_mimic_run

# Aliases used by build_mimic_datasets.py (same values)
export TRIAL6_MEASUREMENTS_CSV="${MOF_MEASUREMENTS_CSV}"
export TRIAL6_LABELS_CSV="${MOF_LABELS_CSV}"
export TRIAL6_WFDB_ROOT="${MOF_WFDB_ROOT}"
export TRIAL6_DATA_ROOT="${MOF_PREBUILT_ROOT}"
